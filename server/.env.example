PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# JWT secret - change this to a long random string in production!
JWT_SECRET=change-me-to-a-long-random-secret-key-in-production

# HMAC secret for file integrity signing - must be different from JWT_SECRET
HMAC_SECRET=change-me-to-another-long-random-secret-key-in-production

# JWT token expiry
JWT_EXPIRES_IN=24h
REFRESH_EXPIRES_IN=30d
